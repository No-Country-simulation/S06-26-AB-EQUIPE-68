# =========================================================================
# Template de Configurações do Aplicativo BiT (Backend)
# Copie este arquivo para .env e preencha as variáveis de acordo com seu ambiente.
# NUNCA commite o arquivo .env — ele contém segredos!
# =========================================================================

# Porta em que o servidor Spring Boot irá rodar
SERVER_PORT=8080

# -------------------------------------------------------------------------
# Banco de Dados (MySQL)
# -------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/db_bitapp?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# -------------------------------------------------------------------------
# JPA / Hibernate
# -------------------------------------------------------------------------
# Opções comuns: update, create, create-drop, validate, none
JPA_DDL_AUTO=update
# Exibir os SQLs executados no console (true/false)
JPA_SHOW_SQL=false

# -------------------------------------------------------------------------
# JWT - Segurança
# -------------------------------------------------------------------------
# OBRIGATÓRIO e sem valor padrão: sem JWT_SECRET (ou com menos de 32 caracteres)
# a aplicação não sobe. Gere uma chave própria com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# -------------------------------------------------------------------------
# API do Google Gemini AI
# -------------------------------------------------------------------------
# COMO OBTER SUA API KEY GRATUITA:
# 1. Acesse: https://aistudio.google.com/app/apikey
# 2. Clique em "Create API key"
# 3. Copie a chave exatamente como o AI Studio mostra e cole abaixo.
#    O formato da chave varia ("AIza…" ou "AQ.…"); não corte nem altere nenhum caractere.
GEMINI_API_KEY=AIzaSyD_EXAMPLE_KEY_REPLACE_ME
# Modelo padrão: gemini-3.5-flash-lite (plano gratuito em out/2026: 15 req/min e 500 req/dia)
# O Google retira modelos de projetos novos sem aviso: se a API responder 404, troque o modelo aqui.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
# Tempos (ms) do Gemini: conexão, leitura no check-in (fallback do agente de saúde mental) e leitura nas demais chamadas.
GEMINI_CONNECT_TIMEOUT=1000
GEMINI_CHECKIN_TIMEOUT=5000
GEMINI_TIMEOUT=10000
GEMINI_MAX_RETRIES=2
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# -------------------------------------------------------------------------
# n8n (agentes de acolhimento e de carreira)
# -------------------------------------------------------------------------
# URL vazia desliga o n8n: o backend segue direto para o Gemini / respostas locais.
N8N_MENTAL_HEALTH_URL=
N8N_ASSESSMENT_URL=
# Tempos (ms) por tipo de chamada: conexão, leitura no check-in e leitura na avaliação de carreira.
# No check-in o pior caso (n8n + Gemini, somados) fica em cerca de 12 s, sem nova tentativa; o frontend espera 20 s.
# Subir N8N_MAX_RETRIES multiplica os tempos.
N8N_CONNECT_TIMEOUT=1000
N8N_CHECKIN_TIMEOUT=5000
N8N_ASSESSMENT_TIMEOUT=23000
N8N_MAX_RETRIES=1
# Token do cabeçalho X-Webhook-Token (Header Auth do nó "Webhook Entrada").
# Só é enviado se estiver definido. O mesmo valor vai na credencial criada no n8n.
N8N_WEBHOOK_TOKEN=

# -------------------------------------------------------------------------
# CORS e console H2
# -------------------------------------------------------------------------
# Origens autorizadas a chamar a API pelo navegador (separadas por vírgula, sem curinga).
# Em produção atrás de proxy TLS (Render) inclua a URL pública do app; com o docker-compose
# (frontend no nginx, porta 3000) inclua também http://localhost:3000.
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080
# Console H2 desligado por padrão; mesmo ligado, /h2-console exige token.
H2_CONSOLE_ENABLED=false

# -------------------------------------------------------------------------
# Dataset Vísent (Infraestrutura de Rede)
# -------------------------------------------------------------------------
# Habilita a ingestão automática dos CSVs na inicialização do servidor
# true  = carrega antenas_flp.csv e tensor_concentracao.csv ao subir
# false = não executa a ingestão (padrão recomendado para dev/CI)
VISENT_ENABLED=false
